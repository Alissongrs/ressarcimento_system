# --- Core ---
JWT_SECRET=change_me_in_production
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost

# MySQL DSNs (formato: user:pass@tcp(host:port)/dbname?parseTime=true&charset=utf8mb4&loc=America%2FSao_Paulo)
# Usando nomes dos serviços do docker-compose (db)
DB_APP_URL=app:app@tcp(db:3306)/appdb?parseTime=true&charset=utf8mb4&loc=America%2FSao_Paulo
DB_CONSULTA_URL=app:app@tcp(db:3306)/consultadb?parseTime=true&charset=utf8mb4&loc=America%2FSao_Paulo

# --- Email (opcional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# --- IMAP ingestion (opcional). Defina IMAP_ENABLE=1 para habilitar ---
IMAP_ENABLE=0
IMAP_HOST=imap.example.com
IMAP_PORT=993

# --- OpenAI (OCR/Chat) ---
# Necessário para habilitar /api/v1/ocr/* quando usar proxy de chat
OPENAI_API_KEY=
# Overrides opcionais
OPENAI_API_BASE=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_OCR_MODEL=gpt-4o-mini

# --- OCR Backend (Tesseract via FastAPI) ---
# Se definido, backend encaminha /api/v1/ocr/analyze para este URL
OCR_BACKEND_URL=http://ocr:8000

# Timezone usado pelos containers
TZ=America/Sao_Paulo

