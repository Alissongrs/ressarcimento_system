{
  "manifest_version": 3,
  "name": "SURE — ANEEL",
  "version": "1.5.0",
  "description": "Consulta os protocolos da Ouvidoria da ANEEL e preenche o registro de endereço/solicitação no Fale Conosco para o SURE.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www2.aneel.gov.br/faleconosco/*",
    "https://sure.app.br/*",
    "http://sure.app.br/*",
    "http://179.127.26.37/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "opcoes.html",
  "content_scripts": [
    {
      "matches": [
        "https://sure.app.br/*",
        "http://sure.app.br/*",
        "http://179.127.26.37/*",
        "http://localhost/*"
      ],
      "js": [
        "content_sure.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www2.aneel.gov.br/faleconosco/*"
      ],
      "js": [
        "content_aneel.js",
        "registro_aneel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
