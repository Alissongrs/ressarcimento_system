    "clean:vite": "node -e \"const fs=require('fs'),p=require('path');['node_modules/.vite','node_modules/.vite_theme_fix','dist'].forEach(d=>{try{fs.rmSync(p.join(process.cwd(),d),{recursive:true,force:true});console.log('removed',d)}catch(e){}})\"",
