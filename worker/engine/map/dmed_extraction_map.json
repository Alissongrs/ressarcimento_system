    "data_vencimento": {
      "chain": [
        {"regex": "REF: MÊS / ANO\\s+VENCIMENTO\\s+TOTAL A PAGAR[^\\n]*\\n[^\\n]*?\\d{2}/\\d{4}\\s+(\\d{2}/\\d{2}/\\d{4})\\s+R\\$", "group": 1},
        {"regex": "VENCIMENTO\\s*\\n?\\s*(\\d{2}/\\d{2}/\\d{4})", "group": 1}
