      "anchor": "VENCIMENTO",
      "regex": "REF: MÊS / ANO\\s+VENCIMENTO\\s*\\n?\\s*(\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})",
      "group": 2,
