{
  "documento": "DANF3E - DMED / DME Distribuição S.A. (Poços de Caldas-MG)",
  "_status": "Layout DANF3E padronizado mineiro. SEMELHANTE ao DEMEI (família 'distribuidora municipal') mas com Grupo A4 horosazonal verde.",
  "observacoes_gerais": {
    "encoding": "UTF-8",
    "decimal": "vírgula (BR)",
    "milhar": "ponto",
    "datas": "DD/MM/AAAA",
    "particularidades": [
      "Razão social: 'DME Distribuição S.A. - DMED'",
      "URL chave_acesso = SEFAZ-MG (portalsped.fazenda.mg.gov.br/portalnf3e)",
      "Cliente tem 'CPF/CNPJ' não mascarado",
      "Tabela de itens com modalidade 'HP/HFP' (Horário Ponta / Horário Fora Ponta) — vocabulário próprio DMED",
      "Pode ter linhas de DESCONTO MENSAL com valor negativo + linha de COBRANÇA (estorno)",
      "Pode ter linha 'DEMANDA HFP' duplicada (uma para faturado, outra para sobra de demanda)"
    ]
  },
  "distribuidora": {
    "razao_social": {
      "anchor": "DME Distribuição",
      "regex": "(DME\\s+Distribuição\\s+S\\.A\\.\\s*-\\s*DMED)",
      "group": 1
    },
    "endereco_emissor": {
      "anchor": "Rua",
      "regex": "(Rua\\s+[A-Za-zÁÉÍÓÚçãõ ,]+\\s*–?\\s*[^\\n]+Poços de Caldas[^\\n]+)",
      "group": 1
    },
    "cep_emissor": {
      "anchor": "CEP",
      "regex": "CEP\\s+(\\d{5}-\\d{3})",
      "group": 1
    },
    "cnpj_emissor": {
      "anchor": "CNPJ",
      "regex": "CNPJ\\s+(\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})",
      "group": 1
    },
    "ie_emissor": {
      "anchor": "Insc. Estadual",
      "regex": "Insc\\.\\s*Estadual\\s+(\\d+)",
      "group": 1
    }
  },
  "cliente": {
    "razao_social": {
      "anchor": "linha de razão",
      "regex": "^(GRUPO CASAS BAHIA S\\.A\\.|VIA VAREJO S/?A|[A-Z][A-Z .&]+S\\.?A\\.?)$",
      "group": 1,
      "flags": "MULTILINE"
    },
    "endereco": {
      "anchor": "RUA",
      "regex": "^(RUA[A-Z0-9 ,.]+,\\s*\\d+)$",
      "group": 1,
      "flags": "MULTILINE"
    },
    "bairro_municipio": {
      "anchor": "linha CENTRO /",
      "regex": "^([A-Z]+)\\s*/\\s*([A-Za-zÁÉÍÓÚçãõ -]+)$",
      "group": "1+2",
      "flags": "MULTILINE"
    },
    "cep": {
      "anchor": "CEP:",
      "regex": "CEP:\\s*(\\d{2}\\s*\\d{3}-\\d{3})",
      "group": 1,
      "pos_process": "remover espaço"
    },
    "rota_sequencia": {
      "anchor": "Rota:",
      "regex": "Rota:\\s*(\\d+),\\s+Sequência:\\s*(\\d+)",
      "group": "1+2"
    },
    "cnpj": {
      "anchor": "CPF/CNPJ",
      "regex": "CPF/CNPJ\\s*(\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})",
      "group": 1
    }
  },
  "identificadores_instalacao": {
    "unidade_consumidora": {
      "anchor": "UNIDADE CONSUMIDORA",
      "regex": "UNIDADE CONSUMIDORA\\s*\\n?\\s*(\\d{10})",
      "group": 1
    },
    "codigo_cliente": {
      "anchor": "CÓDIGO DO CLIENTE",
      "regex": "CÓDIGO DO CLIENTE\\s*\\n?\\s*(\\d+)",
      "group": 1
    }
  },
  "nota_fiscal": {
