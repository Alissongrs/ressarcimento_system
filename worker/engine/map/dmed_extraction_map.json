    "regex_linha": "^(TUSD ENERGIA HP|TUSD ENERGIA HFP|DEMANDA HFP|DEMANDA HP|ENCARGO ESCASSEZ HIDRICA|DEMANDA DESCONTO MENSAL HFP|DEMANDA DESCONTO MENSAL HP|TUSD ENERGIA DESCONTO HP|TUSD ENERGIA DESCONTO HFP|DEMANDA COBRANÇA(?:\\s*-\\s*\\d{2}/\\d{4})?|TUSD ENERGIA HP C(?:\\s*-\\s*\\d{2}/\\d{4})?|C I P - MUNICIPAL)\\s+(kWh|kW|UN)?\\s*([\\-\\d\\.,]+)\\s+([\\d,]+)\\s+([\\-\\d\\.,]+)\\s+([\\-\\d\\.,]+)?\\s*([\\-\\d\\.,]+)?\\s+(\\d+,\\d{2})?\\s+([\\-\\d\\.,]+)?\\s+([\\d,]+)?$",
