    "valor_total": {
      "chain": [
        {"regex": "REF: MÊS / ANO\\s+VENCIMENTO\\s+TOTAL A PAGAR[^\\n]*\\n[^\\n]*?\\d{2}/\\d{4}\\s+\\d{2}/\\d{2}/\\d{4}\\s+R\\$\\s*([\\d\\.]+,\\d{2})", "group": 1},
