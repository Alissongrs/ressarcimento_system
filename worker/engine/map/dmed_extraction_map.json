      "anchor": "NOTA FISCAL Nº",
      "regex": "NOTA FISCAL\\s+Nº\\s+(\\d+)\\s*-\\s*SÉRIE",
      "group": 1
    },
    "serie": {
      "anchor": "SÉRIE",
      "regex": "SÉRIE\\s+(\\d{3})",
      "group": 1
    },
    "data_emissao": {
      "anchor": "DATA DE\\s+EMISSÃO:",
