    "icms_st_flag":      { "anchor": "(*) ICMS, quando aplicável foi recolhido por ST", "regex": "\\(\\*\\)\\s*ICMS,\\s*quando aplicável foi recolhido por ST", "group": 0 },
    "pis_valor":         { "anchor": "PIS",                 "regex": "PIS\\s+([\\d\\.]*,?\\d*)\\s*(?:0,0000)?",                          "group": 1, "obs": "Pode vir zerado no Amazonas — zona franca tem regime tributário especial" },
    "cofins_valor":      { "anchor": "Cofins",              "regex": "Cofins\\s+([\\d\\.]*,?\\d*)\\s*(?:0,0000)?",                        "group": 1 }
