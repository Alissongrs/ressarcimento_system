{
  "documento": "DANF3E - Amazonas Energia",

  "_status": "Layout DANF3E próprio da Amazonas Energia. Extração de texto bagunça as colunas: a tabela de itens da fatura sai com pares chave-valor truncados. Recomenda-se pdfplumber.extract_tables() OU regex linha-a-linha ancorando por DESCRIÇÃO inicial.",

  "observacoes_gerais": {
    "encoding": "UTF-8",
    "decimal": "vírgula (BR)",
    "milhar": "ponto",
    "datas": "DD/MM/AAAA",
    "particularidades": [
      "Cabeçalho de classificação vem TODO em uma linha: 'GRUPO A A4 COMERCIAL COMERCIAL NORMAL Consumo Ponta 226 kWh a 1,748940 1,748940 395,26'",
      "Os campos Grupo/Subgrupo/Subclasse/Classe estão concatenados no início — usar regex de palavra única",
      "CNPJ do cliente vem completo (não mascarado): '33.041.260/0652-90'",
      "Tem campo único 'D. Ctda Pta:' e 'D. Ctda F.Pta:' (demanda contratada ponta e fora ponta separadas)",
      "Bandeira tarifária num quadro próprio com mês e valor R$/kWh",
      "Tarifa Social TSEE — mencionada como aviso, não é dado extraível",
      "Bandeira pode aparecer como 'Adicional Bandeira Amarela' ou 'Adicional Bandeira Vermelha' dentro dos itens da fatura"
    ]
  },

  "distribuidora": {
    "razao_social":      { "anchor": "DOCUMENTO AUXILIAR",  "regex": "(AMAZONAS\\s+ENERGIA)\\s+Documento Auxiliar",                    "group": 1 },
    "cnpj_emissor":      { "anchor": "CNPJ:",               "regex": "CNPJ:\\s*(\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})",              "group": 1 },
    "ie_emissor":        { "anchor": "INSC. ESTADUAL:",     "regex": "INSC\\.\\s*ESTADUAL:\\s*(\\d+)",                                  "group": 1 },
    "endereco_emissor":  { "anchor": "AV DJALMA",           "regex": "(AV\\s+DJALMA\\s+BATISTA,\\s*[\\d\\.]+\\s*-\\s*[A-Z]+)",         "group": 1 },
    "bairro_municipio":  { "anchor": "MANAUS",              "regex": "([A-Z]+),\\s*MANAUS\\s*-\\s*AM",                                   "group": 1 },
    "cep_emissor":       { "anchor": "CEP:",                "regex": "CEP:\\s*(\\d{2}\\.\\d{3}-\\d{3})",                                "group": 1, "pos_process": "remover ponto" }
  },

  "cliente": {
    "razao_social": {
      "chain": [
        {"regex": "(GRUPO CASAS BAHIA\\s+S\\.?/?A\\.?)", "group": 1},
        {"regex": "(VIA VAREJO\\s+S\\.?/?\\s*A\\.?)", "group": 1},
        {"regex": "(VIA S\\.?\\s*A\\.?)\\b", "group": 1},
        {"regex": "^([A-Z][A-Z .&]+\\s+S\\.?/?A\\.?)\\s*$", "group": 1, "flags": "MULTILINE"}
      ]
    },
    "endereco":          { "anchor": "AV AUTAZ MIRIM",      "regex": "^(AV[A-Z .,0-9]+|RUA[A-Z .,0-9]+|R [A-Z .,0-9]+),\\s*\\d+\\s*\\.?$", "group": "linha-1", "obs": "Endereço sem CEP na mesma linha" },
    "bairro":            { "anchor": "linha após endereço", "regex": "^([A-Z]+),\\s+AME\\s+\\d+\\s+-\\s+Código",                       "group": 1 },
    "cep":               { "anchor": "CEP",                 "regex": "CEP\\s+(\\d{2}\\.\\d{3}-\\d{3})\\s*-\\s*MANAUS",                  "group": 1, "pos_process": "remover ponto" },
    "cnpj":              { "anchor": "CNPJ",                "regex": "CNPJ\\s+(\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2})\\s+MF",          "group": 1 },
    "mf_sp":             { "anchor": "MF",                  "regex": "MF\\s+SP\\s+([\\d\\-]+)",                                          "group": 1, "obs": "identificador interno tipo '07-08-08'" },
    "fd":                { "anchor": "FD",                  "regex": "FD\\s+(\\d+)",                                                     "group": 1 }
  },

  "identificadores_instalacao": {
    "uc_codigo_unico":   { "anchor": "Código Único",        "regex": "(\\d{7}-\\d)\\s+\\d{2}/\\d{2}/\\d{4}\\s+\\d{2}/\\d{4}",            "group": 1, "obs": "Aparece também como '06006175' no rodapé sem traço" },
    "uc_sem_traço":      { "anchor": "UC Mês Faturado",     "regex": "(\\d{8})\\s+\\d{2}/\\d{4}\\s+\\d{2}\\s+\\d+\\s+\\d{2}/\\d{2}/\\d{4}", "group": 1 },
    "medidor":           { "anchor": "Número do Medidor",   "regex": "(?:ALTA TENSAO|BAIXA TENSAO|MEDIA TENSAO)\\s+(\\d+)\\s+(?:NORMAL|EMERG)", "group": 1 }
  },

  "classificacao": {
    "estrategia": "Linha única no formato: 'GRUPO X SUBGRUPO SUBCLASSE CLASSE TIPO_FATURAMENTO'",
    "grupo":             { "anchor": "GRUPO",               "regex": "(GRUPO\\s+[AB])\\s+(A[1-4]|B[1-4]|AS)\\s+",                       "group": 1 },
    "subgrupo":          { "anchor": "GRUPO",               "regex": "(GRUPO\\s+[AB])\\s+(A[1-4]|B[1-4]|AS)\\s+",                       "group": 2 },
    "subclasse":         { "anchor": "linha de classificação", "regex": "(?:A[1-4]|B[1-4]|AS)\\s+(COMERCIAL|RESIDENCIAL|INDUSTRIAL|RURAL|PODER PUBLICO)\\s+", "group": 1 },
    "classe":            { "anchor": "linha de classificação", "regex": "(?:A[1-4]|B[1-4]|AS)\\s+(?:COMERCIAL|RESIDENCIAL|INDUSTRIAL|RURAL|PODER PUBLICO)\\s+(COMERCIAL|RESIDENCIAL|INDUSTRIAL|RURAL|PODER PUBLICO)\\s+(NORMAL|REDUZIDA)", "group": 1 },
    "modalidade":        { "anchor": "MODALIDADE",          "regex": "(NORMAL|HOROSAZONAL VERDE|HOROSAZONAL AZUL|CONVENCIONAL|BRANCA)\\s+(NORMAL|HOROSAZONAL VERDE|HOROSAZONAL AZUL|CONVENCIONAL|BRANCA)", "group": 2 },
    "tipo_ligacao":      { "anchor": "Ligação",             "regex": "(ALTA TENSAO|MEDIA TENSAO|BAIXA TENSAO|MONOFASICA|BIFASICA|TRIFASICA)", "group": 1 },
    "tensao_contratada_v": { "anchor": "Tensao Contratada", "regex": "Tensao Contratada\\s*-\\s*(\\d+)V",                                "group": 1 },
    "faixa_adequada":    { "anchor": "Faixa Adequada",      "regex": "Faixa Adequada\\s*-\\s*(\\d+)\\s*a\\s*(\\d+)KV",                  "group": "1-2" }
  },

  "nota_fiscal": {
    "numero_nf":         { "anchor": "Nota Fiscal Nº",      "regex": "Nota Fiscal\\s*Nº\\s+(\\d+)",                                      "group": 1 },
    "serie":             { "anchor": "Série",               "regex": "Série\\s+(\\d{3})",                                                "group": 1 },
    "data_emissao":      { "anchor": "Data de Emissão:",    "regex": "Data de Emissão:\\s*(\\d{2}/\\d{2}/\\d{4})",                      "group": 1 },
    "data_apresentacao": { "anchor": "Apresentação",        "regex": "(\\d+)\\s+(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})\\s*\\n\\s*Dados da Leitura", "group": 3, "obs": "Tabela 'Dias / Emissão / Apresentação' — terceira coluna" },
    "chave_acesso":      { "anchor": "Chave de acesso:",    "regex": "Chave de acesso:\\s*((?:\\d{4}\\s){10}\\d{4})",                    "group": 1, "pos_process": "remover espaços → 44 dígitos" },
    "protocolo_autorizacao": { "anchor": "Protocolo de Autorização:", "regex": "Protocolo de Autorização:\\s*(\\d+)\\s*-\\s*(\\d{2}/\\d{2}/\\d{4})\\s*as\\s*(\\d{2}:\\d{2}:\\d{2})[^\\n]*", "group": "1+2+3" },
    "url_consulta":      { "anchor": "Consulte pela Chave", "regex": "https://[a-zA-Z0-9./-]+",                                          "group": 0 }
  },

  "periodo_leitura": {
    "leitura_anterior":  { "anchor": "Leitura anterior",    "regex": "Leitura anterior\\s+Leitura atual\\s+Próxima leitura[^\\n]*\\n\\s*(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})", "group": 1, "flags": "DOTALL" },
    "leitura_atual":     { "anchor": "Leitura atual",       "regex": "Leitura anterior\\s+Leitura atual\\s+Próxima leitura[^\\n]*\\n\\s*(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})", "group": 2, "flags": "DOTALL" },
    "proxima_leitura":   { "anchor": "Próxima leitura",     "regex": "Leitura anterior\\s+Leitura atual\\s+Próxima leitura[^\\n]*\\n\\s*(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})\\s+(\\d{2}/\\d{2}/\\d{4})", "group": 3, "flags": "DOTALL" },
    "dias_consumo":      { "anchor": "Dias de consumo",     "regex": "Dias de consumo\\s+Emissão\\s+Apresentação\\s*\\n\\s*(\\d+)\\s+",  "group": 1 }
  },

  "vencimento_valor": {
    "data_vencimento":   { "anchor": "Vencimento",          "regex": "Vencimento\\s+Mês Faturado[^\\n]*\\n[^\\n]*?(\\d{2}/\\d{2}/\\d{4})", "group": 1, "flags": "DOTALL" },
    "mes_faturado":      { "anchor": "Mês Faturado",        "regex": "(\\d{2}/\\d{4})\\s*\\n\\s*CNPJ",                                  "group": 1 },
    "valor_total":       { "anchor": "Total a pagar R$",    "regex": "Total a pagar R\\$\\s*([\\d\\.]+,\\d{2})",                        "group": 1 }
  },

  "grandezas_contratadas": {
    "demanda_contratada_ponta_kw":      { "anchor": "D. Ctda Pta:",   "regex": "D\\.\\s*Ctda Pta:\\s*(\\d+)",                            "group": 1 },
    "demanda_contratada_fora_ponta_kw": { "anchor": "D. Ctda F.Pta:", "regex": "D\\.\\s*Ctda F\\.Pta:\\s*(\\d+)",                        "group": 1 }
  },

  "tabela_itens_fatura": {
    "estrategia": "Itens vêm em UMA LINHA SÓ por item, com formato: 'DESCRIÇÃO QUANTIDADE UNIDADE a TARIFA TARIFA VALOR'. A primeira linha tem o GRUPO/SUBGRUPO prefixado — descartar esse prefixo.",
    "regex_linha": "(Consumo Ponta|Consumo F/Ponta|Consumo F\\.Ponta|Demanda|En R Exc F/Ponta|En R Exc Ponta|Adicional Bandeira (?:Amarela|Vermelha|Verde)|Contribuição de Iluminação Pública \\(COSIP\\))\\s+([\\d\\.]+)?\\s*(kWh|kW)?\\s*(?:a\\s+([\\d,]+))?\\s+([\\d,]+)?\\s+([\\d\\.]+,\\d{2})",
    "colunas_em_ordem": ["descricao","quantidade","unidade","tarifa_sem_imposto","tarifa","valor_rs"],
    "descricoes_conhecidas_A4_horosazonal_verde": [
      "Consumo Ponta",
